---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const DEFAULT_DESCRIPTION = "Регистър на удостоверенията за въвеждане в експлоатация (Акт 16) и разрешенията за строеж в София — с данни от НАГ, обновявани ежедневно.";

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const navLinks = [
  { href: "/", label: "Начало", match: (p: string) => p === "/" },
  { href: "/register/act16", label: "Акт 16", match: (p: string) => p.startsWith("/register/act16") },
  { href: "/register/permits", label: "Разрешения", match: (p: string) => p.startsWith("/register/permits") },
  { href: "/stats", label: "Статистика", match: (p: string) => p.startsWith("/stats") },
  { href: "/blog", label: "Блог", match: (p: string) => p.startsWith("/blog") },
];
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />

    <meta name="theme-color" content="#7c3aed" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Акт 16" />
    <link rel="apple-touch-icon" href="/icons/icon-192.svg" />
    <link rel="manifest" href="/manifest.json" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:locale" content="bg_BG" />
    <meta property="og:site_name" content="Акт 16 Тракер" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-92FYWLG2LM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-92FYWLG2LM');
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <div class="nav">
          <a href="/" class="nav__logo" aria-label="Акт 16 Тракер — начало">
            <span class="nav__logo-icon">16</span>
            <span class="nav__logo-text">Акт 16 Тракер</span>
          </a>
          <button
            type="button"
            class="nav__toggle"
            aria-controls="primary-nav"
            aria-expanded="false"
            aria-label="Меню"
          >
            <span class="nav__toggle-bar"></span>
            <span class="nav__toggle-bar"></span>
            <span class="nav__toggle-bar"></span>
          </button>
          <ul class="nav__links" id="primary-nav">
            {navLinks.map((link) => {
              const isActive = link.match(pathname);
              return (
                <li>
                  <a
                    href={link.href}
                    class:list={["nav__link", { "nav__link--active": isActive }]}
                    aria-current={isActive ? "page" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </div>
    </header>

    <main class="main">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer__inner">
          <p>
            Данните са от публичния регистър на
            <a href="https://nag.sofia.bg" target="_blank" rel="noopener">НАГ — Столична община</a>.
          </p>
          <p class="footer__auto">Обновява се автоматично всеки ден.</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js");
      }

      (function () {
        var toggle = document.querySelector(".nav__toggle");
        var menu = document.getElementById("primary-nav");
        var header = document.querySelector(".site-header");
        if (!toggle || !menu || !header) return;

        function close() {
          header.classList.remove("site-header--menu-open");
          toggle.setAttribute("aria-expanded", "false");
        }
        function open() {
          header.classList.add("site-header--menu-open");
          toggle.setAttribute("aria-expanded", "true");
        }

        toggle.addEventListener("click", function () {
          if (toggle.getAttribute("aria-expanded") === "true") close();
          else open();
        });

        menu.addEventListener("click", function (e) {
          if (e.target instanceof HTMLAnchorElement) close();
        });

        document.addEventListener("click", function (e) {
          if (toggle.getAttribute("aria-expanded") !== "true") return;
          if (header.contains(e.target)) return;
          close();
        });

        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") close();
        });
      })();
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border-light);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    background: rgba(255, 255, 255, 0.92);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 56px;
    padding: 0.45rem 0;
  }

  .nav__logo {
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--color-text);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    letter-spacing: -0.02em;
    flex-shrink: 0;
  }

  .nav__logo:hover { color: var(--color-primary); }

  .nav__logo-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    background: linear-gradient(135deg, var(--color-primary), var(--color-coral));
    color: white;
    font-size: 0.72rem;
    font-weight: 800;
    border-radius: 8px;
    letter-spacing: 0;
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(124, 58, 237, 0.25);
  }

  .nav__toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius);
    cursor: pointer;
    transition: border-color var(--transition), background var(--transition);
    align-items: center;
  }

  .nav__toggle:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .nav__toggle-bar {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform var(--transition), opacity var(--transition);
  }

  .site-header--menu-open .nav__toggle-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .site-header--menu-open .nav__toggle-bar:nth-child(2) { opacity: 0; }
  .site-header--menu-open .nav__toggle-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .nav__links {
    list-style: none;
    display: none;
    flex-direction: column;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-border-light);
    box-shadow: 0 10px 30px -10px rgba(28, 25, 23, 0.12);
    padding: 0.5rem 1rem 0.85rem;
    gap: 0.2rem;
    margin: 0;
  }

  .site-header--menu-open .nav__links { display: flex; }

  .nav__link {
    display: flex;
    align-items: center;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    padding: 0.85rem 0.85rem;
    border-radius: var(--radius);
    transition: all var(--transition);
    border: 1.5px solid transparent;
  }

  .nav__link:hover {
    color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .nav__link--active {
    color: var(--color-primary);
    background: var(--color-primary-light);
    border-color: rgba(124, 58, 237, 0.18);
  }

  .main {
    flex: 1;
    padding: 1.25rem 0 2rem;
    padding-bottom: calc(2rem + var(--safe-bottom));
  }

  .site-footer {
    border-top: 1px solid var(--color-border-light);
    padding: 1.5rem 0;
    padding-bottom: calc(1.5rem + var(--safe-bottom));
    text-align: center;
  }

  .footer__inner {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .footer__auto {
    margin-top: 0.2rem;
    font-size: 0.7rem;
    opacity: 0.7;
  }

  @media (min-width: 720px) {
    .nav { min-height: 60px; padding: 0.6rem 0; }

    .nav__logo { font-size: 1.15rem; gap: 0.6rem; }
    .nav__logo-icon { width: 32px; height: 32px; font-size: 0.78rem; border-radius: 9px; }

    .nav__toggle { display: none; }

    .nav__links {
      display: flex;
      flex-direction: row;
      position: static;
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border: none;
      box-shadow: none;
      padding: 0;
      gap: 0.2rem;
    }

    .nav__link {
      font-size: 0.875rem;
      padding: 0.45rem 0.85rem;
    }

    .nav__link--active {
      border-color: transparent;
    }
  }

  @media (min-width: 640px) {
    .main { padding: 2rem 0 3rem; }
    .site-footer { padding: 2rem 0; }
    .footer__inner { font-size: 0.8rem; }
  }
</style>
