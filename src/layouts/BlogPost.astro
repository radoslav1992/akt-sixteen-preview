---
import Base from "./Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FaqList from "../components/FaqList.astro";
import Icon from "../components/Icon.astro";
import { breadcrumbs, canonicalUrl, SITE_URL } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  date: Date;
  updatedDate?: Date;
  tags: string[];
  faq?: Array<{ q: string; a: string }>;
  lang?: "bg" | "en" | "ru";
  alternates?: Array<{ hreflang: string; href: string }>;
  related?: Array<{ title: string; href: string }>;
}

const { title, description, date, updatedDate, tags, faq = [], lang = "bg", alternates = [], related = [] } = Astro.props;
const locale = { bg: "bg-BG", en: "en-GB", ru: "ru-RU" }[lang];
const formattedDate = date.toLocaleDateString(locale, { day: "numeric", month: "long", year: "numeric" });
const isoDate = date.toISOString();
const t = {
  bg: { home: "Начало", blog: "Ръководства", updated: "Обновено", faq: "Често задавани въпроси", check: "Проверка на имот", checkText: "Търсете по адрес, квартал или кадастрален идентификатор в двата регистъра.", all: "Всички статии", related: "Още по темата", reading: "мин. четене" },
  en: { home: "Home", blog: "Guides", updated: "Updated", faq: "Frequently asked questions", check: "Check a property", checkText: "Search Sofia's registers by address, neighbourhood or cadastral identifier.", all: "All guides (BG)", related: "Related", reading: "min read" },
  ru: { home: "Главная", blog: "Руководства", updated: "Обновлено", faq: "Частые вопросы", check: "Проверка объекта", checkText: "Поиск в реестрах Софии по адресу, кварталу или кадастровому идентификатору.", all: "Все статьи (BG)", related: "По теме", reading: "мин. чтения" },
}[lang];

const article = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: isoDate,
  dateModified: (updatedDate ?? date).toISOString(),
  mainEntityOfPage: canonicalUrl(Astro.url.pathname),
  image: `${SITE_URL}/og/default.png`,
  author: { "@type": "Organization", name: "Акт 16 Тракер", url: `${SITE_URL}/` },
  publisher: { "@id": `${SITE_URL}/#organization` },
  inLanguage: lang,
  keywords: tags.join(", "),
};
const faqLd = faq.length
  ? { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) }
  : null;
const crumbs = [{ name: t.home, path: "/" }, { name: t.blog, path: "/blog/" }, { name: title, path: Astro.url.pathname }];
---

<Base title={`${title} | Акт 16`} description={description} type="article" lang={lang} alternates={alternates}
  structuredData={[article, breadcrumbs(crumbs), ...(faqLd ? [faqLd] : [])]}>
  <Breadcrumbs items={[{ name: t.home, path: "/" }, { name: t.blog, path: "/blog/" }, { name: title }]} />

  <div class="post-layout">
    <article class="post">
      <header class="post__header">
        <div class="post__meta">
          <time datetime={isoDate}>{formattedDate}</time>
          {updatedDate && <span>· {t.updated}: <time datetime={updatedDate.toISOString()}>{updatedDate.toLocaleDateString(locale)}</time></span>}
        </div>
        <h1>{title}</h1>
        <p class="post__lead">{description}</p>
        <div class="chip-row post__tags">{tags.map((tag) => <span class="badge">{tag}</span>)}</div>
      </header>

      <div class="prose post__content">
        <slot />
      </div>

      {faq.length > 0 && (
        <section class="post__faq" aria-labelledby="faq-title">
          <h2 id="faq-title">{t.faq}</h2>
          <FaqList items={faq} />
        </section>
      )}

      <footer class="post__footer">
        <a href="/blog/"><Icon name="back" size={16} /> {t.all}</a>
      </footer>
    </article>

    <aside class="post-aside">
      <div class="panel-dark blueprint aside-cta">
        <Icon name="search" size={26} />
        <h2>{t.check}</h2>
        <p>{t.checkText}</p>
        <form action="/check/" method="get" role="search">
          <label class="sr-only" for="aside-q">{t.check}</label>
          <input id="aside-q" name="q" type="search" placeholder="68134.… / ул. …" />
          <button class="btn btn--primary" type="submit">{lang === "bg" ? "Провери" : lang === "ru" ? "Проверить" : "Check"}</button>
        </form>
      </div>
      <nav class="card aside-links" aria-label={t.related}>
        <h2>{t.related}</h2>
        {related.length > 0
          ? related.map((r) => <a href={r.href}>{r.title}</a>)
          : <>
              <a href="/register/act16/">Регистър Акт 16</a>
              <a href="/register/permits/">Регистър на разрешенията за строеж</a>
              <a href="/map/">Карта на строителството</a>
              <a href="/stats/">Статистика</a>
            </>}
      </nav>
    </aside>
  </div>
</Base>

<style>
  .post-layout { display: grid; gap: 2rem; }
  @media (min-width: 1080px) { .post-layout { grid-template-columns: minmax(0, 740px) 1fr; gap: 3.5rem; } }
  .post__header { padding: 1rem 0 1.5rem; border-bottom: 2px solid var(--ink); margin-bottom: 2rem; }
  .post__meta { font-size: 0.88rem; color: var(--muted); display: flex; flex-wrap: wrap; gap: 0.35rem; font-weight: 600; }
  .post h1 { margin-top: 0.75rem; font-size: clamp(2rem, 1.4rem + 2.4vw, 3.2rem); }
  .post__lead { margin-top: 1rem; font-size: 1.15rem; color: var(--muted); }
  .post__tags { margin-top: 1rem; }
  .post__faq { margin-top: 3rem; }
  .post__faq h2 { margin-bottom: 1rem; }
  .post__footer { margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .post__footer a { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 700; }
  .post-aside { display: grid; gap: 1rem; align-content: start; }
  @media (min-width: 1080px) { .post-aside { position: sticky; top: 92px; } }
  .aside-cta { padding: 1.4rem; display: grid; gap: 0.7rem; color: var(--yellow); }
  .aside-cta h2 { font-size: 1.4rem; text-transform: uppercase; }
  .aside-cta form { display: grid; gap: 0.5rem; }
  .aside-cta input { background: rgba(255, 255, 255, 0.08); border-color: var(--asphalt-line); color: #fff; }
  .aside-links { display: grid; gap: 0.5rem; }
  .aside-links h2 { font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .aside-links a { font-weight: 600; }
</style>
