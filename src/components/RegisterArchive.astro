---
import DocRow from "./DocRow.astro";
import Icon from "./Icon.astro";
import { getRecords, type RegisterId } from "../lib/data";
interface Props { registerId: RegisterId; page?: number }
const { registerId, page = 1 } = Astro.props;
const records = getRecords(registerId);
const pageSize = 100;
const totalPages = Math.ceil(records.length / pageSize);
const entries = records.slice((page - 1) * pageSize, page * pageSize);
const pageUrl = (n: number) => `/register/${registerId}/archive/${n}/`;
const windowPages = Array.from({ length: totalPages }, (_, i) => i + 1).filter((n) => n === 1 || n === totalPages || Math.abs(n - page) <= 2);
---
<section class="archive" aria-labelledby="archive-title">
  <h2 id="archive-title" class="sr-only">{registerId === "act16" ? "Архив на удостоверенията за въвеждане в експлоатация" : "Архив на разрешенията за строеж"}</h2>
  <p class="archive__meta">Страница {page} от {totalPages} · Записи {(page - 1) * pageSize + 1}–{Math.min(page * pageSize, records.length)} от {records.length}</p>
  <ol class="doc-list" start={(page - 1) * pageSize + 1}>
    {entries.map((r) => <DocRow registerId={registerId} record={r} />)}
  </ol>
  <nav class="pager" aria-label="Страници в архива">
    {page > 1 && <a href={pageUrl(page - 1)} rel="prev" aria-label="Предишна"><Icon name="back" size={16} /></a>}
    {windowPages.map((n, i) => (
      <>
        {i > 0 && n - windowPages[i - 1] > 1 && <span>…</span>}
        {n === page ? <span aria-current="page">{n}</span> : <a href={pageUrl(n)}>{n}</a>}
      </>
    ))}
    {page < totalPages && <a href={pageUrl(page + 1)} rel="next" aria-label="Следваща"><Icon name="arrow" size={16} /></a>}
  </nav>
</section>
<style>
  .archive { margin: 1.5rem 0; }
  .archive__meta { color: var(--muted); margin-bottom: 1rem; font-weight: 600; }
</style>
