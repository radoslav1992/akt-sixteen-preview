---
// Grouped vertical bars by year. Two series max (Разрешения / Акт 16); legend + per-bar tooltips + hidden table.
import { fmtNumber } from "../lib/format";
interface Series { id: "act16" | "permits"; label: string; values: Map<string, number> }
interface Props { series: Series[]; caption: string; height?: number }
const { series, caption, height = 200 } = Astro.props;

const years = [...new Set(series.flatMap((s) => [...s.values.keys()]))].sort();
const max = Math.max(1, ...series.flatMap((s) => [...s.values.values()]));
const W = 640, H = height, top = 18, bottom = 26, left = 6, right = 6;
const plotH = H - top - bottom;
const groupW = (W - left - right) / Math.max(1, years.length);
const gap = 2;
const barW = Math.min(46, (groupW * 0.72 - gap * (series.length - 1)) / series.length);
const single = series.length === 1;

function barPath(x: number, y: number, w: number, h: number): string {
  const r = Math.min(4, w / 2, h);
  return `M${x},${y + h}V${y + r}Q${x},${y} ${x + r},${y}H${x + w - r}Q${x + w},${y} ${x + w},${y + r}V${y + h}Z`;
}
---
<figure class="chart-wrap" data-chart>
  {!single && (
    <div class="chart-legend">
      {series.map((s) => <span><i style={`background:var(--mark-${s.id})`}></i>{s.label}</span>)}
    </div>
  )}
  <svg class="chart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={caption}>
    {[0.25, 0.5, 0.75, 1].map((t) => <line class="chart__grid" x1={left} x2={W - right} y1={top + plotH * (1 - t)} y2={top + plotH * (1 - t)} />)}
    <line class="chart__axis" x1={left} x2={W - right} y1={top + plotH} y2={top + plotH} />
    {years.map((year, gi) => {
      const groupX = left + gi * groupW + (groupW - (barW * series.length + gap * (series.length - 1))) / 2;
      return (
        <g>
          {series.map((s, si) => {
            const v = s.values.get(year) ?? 0;
            const h = Math.max(v ? 2 : 0, (v / max) * plotH);
            const x = groupX + si * (barW + gap);
            const y = top + plotH - h;
            return (
              <g>
                <path d={barPath(x, y, barW, h)} fill={`var(--mark-${s.id})`} />
                <rect x={x - 2} y={top} width={barW + 4} height={plotH} fill="transparent" data-tip={`<b>${year}</b> · ${s.label}: ${fmtNumber(v)}`} tabindex="0" />
                {single && <text class="chart__value" x={x + barW / 2} y={y - 5} text-anchor="middle">{fmtNumber(v)}</text>}
              </g>
            );
          })}
          <text x={left + gi * groupW + groupW / 2} y={H - 8} text-anchor="middle">{year}</text>
        </g>
      );
    })}
  </svg>
  <table class="sr-only">
    <caption>{caption}</caption>
    <thead><tr><th>Година</th>{series.map((s) => <th>{s.label}</th>)}</tr></thead>
    <tbody>{years.map((y) => <tr><td>{y}</td>{series.map((s) => <td>{s.values.get(y) ?? 0}</td>)}</tr>)}</tbody>
  </table>
</figure>

<script>
  import { initChartTips } from "../scripts/charttips";
  initChartTips();
</script>
