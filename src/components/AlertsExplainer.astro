---
// What the free email alerts are, in one block (home page and the two register search pages).
// Keep it true to src/lib/alerts.ts: one digest a day, only when something new matches, sent to
// verified accounts; every email carries an unsubscribe link (src/pages/api/alerts/unsubscribe.ts).
import Icon from "./Icon.astro";
interface Props { id?: string }
const { id = "izvestiya" } = Astro.props;
---
<section class="section alerts card hazard-edge" id={id} aria-labelledby={`${id}-title`}>
  <div class="alerts__copy">
    <span class="eyebrow">Безплатни имейл известия</span>
    <h2 id={`${id}-title`}>Имейл, когато излезе нов Акт 16 или разрешение за строеж</h2>
    <p>Отворете район, квартал, имот или фирма и натиснете „Извести ме по имейл“. Когато в регистрите на НАГ се появи нов документ за избраното, ще го получите на имейла си — без да проверявате сами.</p>
    <div class="alerts__actions">
      <a class="btn btn--primary" href="/region/"><Icon name="bell" /> Изберете район</a>
      <a class="btn btn--ghost" href="/check/"><Icon name="search" /> Проверете имот</a>
    </div>
  </div>
  <ul class="alerts__points">
    <li><Icon name="clock" size={20} /><div><strong>Едно писмо на ден</strong><p>Събираме новите документи по следеното от вас в едно писмо след ежедневното обновяване на данните. В дните без промяна не пишем.</p></div></li>
    <li><Icon name="check" size={20} /><div><strong>Безплатно</strong><p>Нужен е само безплатен профил с имейл адрес, който потвърждавате с връзка от писмо.</p></div></li>
    <li><Icon name="close" size={20} /><div><strong>Отписване с един клик</strong><p>От връзката във всяко писмо, без вход в профила. Списъкът ви остава.</p></div></li>
  </ul>
</section>

<style>
  .alerts { display: grid; gap: 1.5rem; padding-left: 1.6rem; }
  @media (min-width: 900px) { .alerts { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 2.5rem; padding: 2rem 2rem 2rem 2.4rem; align-items: center; } }
  .alerts h2 { margin: 0.5rem 0 0.6rem; }
  .alerts__copy p { color: var(--muted); max-width: 60ch; }
  .alerts__actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.1rem; }
  .alerts__points { list-style: none; display: grid; gap: 0.9rem; }
  .alerts__points li { display: flex; gap: 0.75rem; align-items: flex-start; }
  .alerts__points :global(svg) { margin-top: 0.15rem; color: var(--orange); }
  .alerts__points strong { color: var(--ink); }
  .alerts__points p { color: var(--muted); font-size: 0.93rem; }
</style>
