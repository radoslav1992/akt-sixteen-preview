---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Icon from "../../components/Icon.astro";
import { breadcrumbs } from "../../lib/seo";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => (b.data.updatedDate ?? b.data.date).getTime() - (a.data.updatedDate ?? a.data.date).getTime()
);
const guides = await getCollection("intl");
const [lead, ...rest] = posts;
const fmt = (d: Date) => d.toLocaleDateString("bg-BG", { day: "numeric", month: "long", year: "numeric" });
const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: posts.map((p, i) => ({ "@type": "ListItem", position: i + 1, url: `https://akt16.org/blog/${p.id}/`, name: p.data.title })),
};
---

<Base
  title="Ръководства за Акт 16, разрешения за строеж и ново строителство"
  description="Статии за Акт 14, Акт 15, Акт 16, разрешения за строеж и ползване, проверка на имот и пазара на ново строителство в София — с данни от регистрите на НАГ."
  structuredData={[itemList, breadcrumbs([{ name: "Начало", path: "/" }, { name: "Ръководства", path: "/blog/" }])]}
>
  <Breadcrumbs items={[{ name: "Начало", path: "/" }, { name: "Ръководства" }]} />
  <header class="page-head">
    <span class="eyebrow">Блог · ръководства</span>
    <h1>Акт 16, разрешения и ново строителство — обяснено просто</h1>
    <p class="page-head__lead">Практични ръководства за купувачи, инвеститори и собственици: какво означават строителните документи, как се проверяват и какво показват данните.</p>
  </header>

  {lead && (
    <a href={`/blog/${lead.id}/`} class="lead-post panel-dark blueprint">
      <span class="eyebrow">Обновено {fmt(lead.data.updatedDate ?? lead.data.date)}</span>
      <h2>{lead.data.title}</h2>
      <p>{lead.data.description}</p>
      <span class="lead-post__more">Прочети <Icon name="arrow" size={16} /></span>
    </a>
  )}

  <section class="section grid-auto post-grid">
    {rest.map((post) => (
      <a href={`/blog/${post.id}/`} class="card post-card">
        <time datetime={(post.data.updatedDate ?? post.data.date).toISOString()}>{fmt(post.data.updatedDate ?? post.data.date)}</time>
        <h2>{post.data.title}</h2>
        <p>{post.data.description}</p>
        <span class="chip-row">{post.data.tags.slice(0, 3).map((t) => <span class="badge">{t}</span>)}</span>
      </a>
    ))}
  </section>

  {guides.length > 0 && (
    <section class="section">
      <div class="section-head"><h2>Guides in other languages</h2></div>
      <div class="grid-auto">
        {guides.map((g) => (
          <a href={`/${g.data.lang}/${g.data.slug}/`} class="card post-card" lang={g.data.lang} hreflang={g.data.lang}>
            <span class="badge badge--yellow">{g.data.lang.toUpperCase()}</span>
            <h2>{g.data.title}</h2>
            <p>{g.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  .lead-post { display: grid; gap: 0.8rem; padding: clamp(1.5rem, 1rem + 3vw, 3rem); margin-top: 1rem; color: inherit; }
  .lead-post .eyebrow { color: var(--yellow); }
  .lead-post h2 { font-size: clamp(1.8rem, 1.3rem + 2vw, 2.8rem); max-width: 860px; }
  .lead-post p { max-width: 760px; font-size: 1.05rem; }
  .lead-post__more { color: var(--yellow); font-family: var(--font-display); font-weight: 800; text-transform: uppercase; display: inline-flex; gap: 0.4rem; align-items: center; }
  .post-card { display: flex; flex-direction: column; gap: 0.6rem; }
  .post-card time { font-size: 0.8rem; color: var(--muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
  .post-card h2 { font-size: 1.35rem; }
  .post-card p { color: var(--muted); font-size: 0.95rem; flex: 1; }
</style>
