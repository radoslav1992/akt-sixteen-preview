---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import MonthlyTrend from "../components/MonthlyTrend.astro";
import YearBars from "../components/YearBars.astro";
import BarList from "../components/BarList.astro";
import SofiaMap from "../components/SofiaMap.astro";
import { breadcrumbs } from "../lib/seo";
import { getRegister, getAllRegionsWithSlugs, getRegionRecords } from "../lib/data";
import { topCompanies } from "../lib/companies";
import { classify, BUILDING_TYPES } from "../lib/classify";
import { pipelineMatches, durationStats } from "../lib/parcels";
import { byMonth, byYear, countBy, inLastDays, completeMonths } from "../lib/stats";
import { fmtNumber, fmtMonths, longDate } from "../lib/format";

const act16 = getRegister("act16").records;
const permits = getRegister("permits").records;
const months = completeMonths(36);
const matches = pipelineMatches();
const all = durationStats(matches);
const regions = getAllRegionsWithSlugs().map((r) => {
  const recs = getRegionRecords(r.name);
  const d = durationStats(matches.filter((m) => m.certificate.region === r.name));
  return { ...r, last12: inLastDays(recs.act16, 365).length + inLastDays(recs.permits, 365).length, dur: d };
});
const byType = BUILDING_TYPES.map((t) => ({ ...t, act16: 0, permits: 0, dur: durationStats(matches.filter((m) => classify(m.certificate) === t.id)) }));
const typeCountsA = countBy(act16, classify);
const typeCountsP = countBy(permits, classify);
for (const t of byType) { t.act16 = typeCountsA.get(t.id) ?? 0; t.permits = typeCountsP.get(t.id) ?? 0; }
const employers = topCompanies("employer", 12);
const oversight = topCompanies("oversight", 12);
const counts = new Map(regions.map((r) => [r.name, r.last12]));
const updated = new Date(getRegister("act16").lastUpdated).toLocaleDateString("bg-BG", { day: "numeric", month: "long", year: "numeric" });
const dataset = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "Статистика на разрешенията за строеж и удостоверенията за въвеждане в експлоатация в София",
  description: "Месечни и годишни бройки, разпределение по райони и типове сгради и срокове от разрешение до Акт 16, изчислени от публичните регистри на НАГ.",
  url: "https://akt16.org/stats/",
  isAccessibleForFree: true,
  creator: { "@type": "Organization", name: "Акт 16 Тракер" },
  spatialCoverage: "София, България",
  distribution: [
    { "@type": "DataDownload", encodingFormat: "text/csv", contentUrl: "https://akt16.org/downloads/act16.csv" },
    { "@type": "DataDownload", encodingFormat: "text/csv", contentUrl: "https://akt16.org/downloads/permits.csv" },
  ],
};
---

<Base
  title="Статистика на строителството в София — Акт 16 и разрешения"
  description="Колко разрешения за строеж и удостоверения Акт 16 се издават в София по месеци, години, райони и типове сгради — и колко време отнема от разрешение до Акт 16."
  structuredData={[dataset, breadcrumbs([{ name: "Начало", path: "/" }, { name: "Статистика", path: "/stats/" }])]}
>
  <Breadcrumbs items={[{ name: "Начало", path: "/" }, { name: "Статистика" }]} />
  <header class="page-head">
    <span class="eyebrow">Данни към {updated}</span>
    <h1>Статистика на строителството в София</h1>
    <p class="page-head__lead">Обобщение на {fmtNumber(permits.length)} разрешения за строеж и {fmtNumber(act16.length)} удостоверения за въвеждане в експлоатация от регистрите на НАГ — по месеци, райони, типове сгради и срокове.</p>
  </header>

  <section class="stat-grid">
    <div class="stat stat--permits"><div class="stat__value">{fmtNumber(inLastDays(permits, 365).length)}</div><div class="stat__label">Разрешения за 12 месеца</div></div>
    <div class="stat stat--act16"><div class="stat__value">{fmtNumber(inLastDays(act16, 365).length)}</div><div class="stat__label">Акт 16 за 12 месеца</div></div>
    <div class="stat"><div class="stat__value">{fmtMonths(all.median)}</div><div class="stat__label">Медиана: разрешение → Акт 16</div><div class="stat__sub">{fmtNumber(all.count)} свързани имота</div></div>
    <div class="stat"><div class="stat__value">{Math.round(all.q1)}–{Math.round(all.q3)} мес.</div><div class="stat__label">Половината от строежите</div><div class="stat__sub">между 1-ви и 3-ти квартил</div></div>
  </section>

  <section class="section card">
    <h2 class="card-title">Издадени документи по месеци</h2>
    <MonthlyTrend months={months} caption="Брой издадени документи по месеци за последните 36 месеца" series={[
      { id: "permits", label: "Разрешения за строеж", short: "Разрешения", values: byMonth(permits) },
      { id: "act16", label: "Акт 16", values: byMonth(act16) },
    ]} />
    <p class="chart-note">Графиката свършва с последния завършен месец. Последните месеци може да са непълни, ако регистрите се попълват със закъснение. Последен документ: Акт 16 — {longDate(act16[0].date)}, разрешение — {longDate(permits[0].date)}.</p>
  </section>

  <section class="section grid-2">
    <div class="card">
      <h2 class="card-title">По години</h2>
      <YearBars caption="Брой документи по години" series={[
        { id: "permits", label: "Разрешения за строеж", values: byYear(permits) },
        { id: "act16", label: "Акт 16", values: byYear(act16) },
      ]} />
      <p class="chart-note">Разрешенията са събрани от 2021 г., удостоверенията — от 2023 г.</p>
    </div>
    <div class="card">
      <h2 class="card-title">Активност по райони за 12 месеца</h2>
      <SofiaMap counts={counts} caption="Документи по район за последните 12 месеца" />
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Райони</h2></div>
    <div class="card table-card">
      <table>
        <thead><tr><th>Район</th><th>Акт 16</th><th>Разрешения</th><th>12 месеца</th><th>Разрешение → Акт 16</th></tr></thead>
        <tbody>
          {regions.map((r) => (
            <tr>
              <td><a href={`/region/${r.slug}/`}><strong>{r.name}</strong></a></td>
              <td class="mono">{fmtNumber(r.act16)}</td>
              <td class="mono">{fmtNumber(r.permits)}</td>
              <td class="mono">{fmtNumber(r.last12)}</td>
              <td class="mono">{r.dur.count >= 30 ? `${fmtMonths(r.dur.median)} (${r.dur.count})` : "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>Какво се строи</h2>
        <p>Типът е определен автоматично по описанието на строежа и е приблизителен.</p>
      </div>
    </div>
    <div class="card table-card">
      <table>
        <thead><tr><th>Тип сграда</th><th>Разрешения</th><th>Акт 16</th><th>Разрешение → Акт 16</th></tr></thead>
        <tbody>
          {byType.map((t) => (
            <tr>
              <td><strong>{t.label}</strong></td>
              <td class="mono">{fmtNumber(t.permits)}</td>
              <td class="mono">{fmtNumber(t.act16)}</td>
              <td class="mono">{t.dur.count >= 30 ? `${fmtMonths(t.dur.median)} (${t.dur.count})` : "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section grid-2">
    <div class="card">
      <h2 class="card-title">Най-активни възложители</h2>
      <BarList tone="permits" rows={employers.map(({ company, count }) => ({ label: company.display, value: count, href: `/company/${company.slug}/` }))} />
    </div>
    <div class="card">
      <h2 class="card-title">Най-активен строителен надзор</h2>
      <BarList tone="act16" rows={oversight.map(({ company, count }) => ({ label: company.display, value: count, href: `/company/${company.slug}/` }))} />
    </div>
  </section>

  <section class="section prose methodology">
    <h2>Методика</h2>
    <p>Срокът „разрешение → Акт 16“ е времето между удостоверение за въвеждане в експлоатация и най-близкото предходно разрешение за строеж със същия кадастрален идентификатор. Разрешенията в данните започват от 2021 г., затова много дълги проекти са подценени, а един имот може да има няколко етапа. Подробности в статията <a href="/blog/ot-razreshenie-do-akt-16/">Колко време отнема от разрешение за строеж до Акт 16</a>.</p>
    <p>Изтеглете суровите данни от <a href="/data/">страницата с отворени данни</a>.</p>
  </section>
</Base>

<style>
  .card-title { font-size: 1.35rem; margin-bottom: 1rem; }
  .chart-note { font-size: 0.85rem; color: var(--muted); margin-top: 0.75rem; }
  .table-card { padding: 0; overflow-x: auto; }
  .table-card td a { color: var(--ink); }
  .methodology { max-width: 820px; }
</style>
