---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getRegister, getRecords, getUniqueDistricts, recordSlug, slugifyRegion, type RegisterId } from "../../lib/data";
import { BUILDING_TYPES } from "../../lib/classify";
import { breadcrumbs } from "../../lib/seo";
import { fmtNumber, sentenceCase, truncate } from "../../lib/format";

// Rendered on demand so legacy filter URLs (?region=…) can be permanently redirected
// to the crawlable district lists instead of competing with them in search.
export const prerender = false;

const registerId = Astro.params.id as RegisterId;
if (registerId !== "act16" && registerId !== "permits") {
  return new Response("Not found", { status: 404 });
}

const regionParam = Astro.url.searchParams.get("region")?.replace(/\s+/g, " ").trim();
if (regionParam) {
  const match = getUniqueDistricts(registerId).find((d) => d.toLocaleLowerCase("bg-BG") === regionParam.toLocaleLowerCase("bg-BG"));
  if (match) return Astro.redirect(`/region/${slugifyRegion(match)}/${registerId}/`, 301);
}

const register = getRegister(registerId);
const records = getRecords(registerId);
const districts = getUniqueDistricts(registerId);
const isPermits = registerId === "permits";
const metaLabel = isPermits ? "Възложител" : "Надзор";
const pageTitle = isPermits ? "Разрешения за строеж в София — регистър и проверка" : "Акт 16 регистър — удостоверения за въвеждане в експлоатация, София";
const heading = isPermits ? "Регистър на издадените разрешения за строеж в София" : "Регистър на удостоверенията за въвеждане в експлоатация (Акт 16)";
const description = isPermits
  ? "Проверете разрешение за строеж (разрешително) в София по адрес, район, номер или възложител. Търсене и филтри по дата и тип сграда с данни от регистъра на НАГ."
  : "Търсете Акт 16 в София по адрес, район, номер или идентификатор КККР. Регистър на удостоверенията за въвеждане в експлоатация с данни от НАГ, обновяван ежедневно.";
const initialRecords = records.slice(0, 30);
const officialUrl = isPermits ? "https://nag.sofia.bg/RegisterBuildingPermitsPortal/Index" : "https://nag.sofia.bg/RegisterCertificateForExploitationBuildings";
const years = [...new Set(records.map((r) => r.date.slice(-4)))].sort();

const dataset = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: register.label + " — София",
  description,
  url: `https://akt16.org/register/${registerId}/`,
  inLanguage: "bg",
  isAccessibleForFree: true,
  creator: { "@type": "Organization", name: "Акт 16 Тракер", url: "https://akt16.org/" },
  isBasedOn: officialUrl,
  spatialCoverage: { "@type": "Place", name: "Столична община, София, България" },
  temporalCoverage: `${years[0]}/..`,
  dateModified: register.lastUpdated,
  distribution: [{ "@type": "DataDownload", encodingFormat: "text/csv", contentUrl: `https://akt16.org/downloads/${registerId}.csv` }],
};

Astro.response.headers.set("Cache-Control", "public, max-age=300");
---

<Base
  title={pageTitle}
  description={description}
  structuredData={[dataset, breadcrumbs([{ name: "Начало", path: "/" }, { name: register.label, path: `/register/${registerId}/` }])]}
  feeds={[{ title: `${register.shortLabel} — нови документи`, href: `/register/${registerId}/rss.xml` }]}
>
  <Breadcrumbs items={[{ name: "Начало", path: "/" }, { name: register.shortLabel }]} />

  <header class="page-head register-head">
    <div>
      <span class="eyebrow">{isPermits ? "Етап 1 · в строеж" : "Етап 3 · въведени в експлоатация"}</span>
      <h1>{heading}</h1>
      <p class="page-head__lead">{description}</p>
    </div>
    <nav class="tabs" aria-label="Регистри">
      <a href="/register/act16/" aria-current={!isPermits ? "page" : undefined}><span class="dot dot--act16"></span> Акт 16</a>
      <a href="/register/permits/" aria-current={isPermits ? "page" : undefined}><span class="dot dot--permits"></span> Разрешения за строеж</a>
    </nav>
  </header>

  <section class="filters card" aria-label="Търсене и филтри">
    <div class="filters__search">
      <label for="search-input" class="field__label">Търсене</label>
      <div class="searchbar searchbar--flat">
        <Icon name="search" />
        <input type="search" id="search-input" placeholder="Адрес, квартал, обект, фирма, № или 68134…" autocomplete="off" />
      </div>
    </div>
    <div class="filters__row">
      <div class="field">
        <label for="region-select" class="field__label">Район</label>
        <select id="region-select">
          <option value="">Всички ({fmtNumber(records.length)})</option>
          {districts.map((d) => <option value={d}>{d}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="type-select" class="field__label">Тип сграда</label>
        <select id="type-select">
          <option value="">Всички типове</option>
          {BUILDING_TYPES.map((t) => <option value={t.id}>{t.label}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="date-from" class="field__label">От дата</label>
        <input type="date" id="date-from" />
      </div>
      <div class="field">
        <label for="date-to" class="field__label">До дата</label>
        <input type="date" id="date-to" />
      </div>
    </div>
    <div class="filters__foot">
      <div class="chip-row" role="group" aria-label="Бързи периоди">
        <button type="button" class="chip preset-btn" data-preset="7">7 дни</button>
        <button type="button" class="chip preset-btn" data-preset="30">30 дни</button>
        <button type="button" class="chip preset-btn" data-preset="90">90 дни</button>
        <button type="button" class="chip preset-btn" data-preset="365">1 година</button>
      </div>
      <div class="filters__actions">
        <button id="clear-filters" class="btn btn--ghost btn--sm" type="button">Изчисти</button>
        <button type="button" class="btn btn--ghost btn--sm" id="export-csv"><Icon name="download" size={16} /> CSV</button>
        <a class="btn btn--ghost btn--sm" href="/map/"><Icon name="map" size={16} /> Карта</a>
      </div>
    </div>
    <div class="active-filters" id="active-filters"></div>
  </section>

  <div class="results-bar">
    <p id="results-count" role="status">{fmtNumber(records.length)} записа</p>
    <a href={`/register/${registerId}/archive/1/`}>Пълен архив по страници</a>
  </div>

  <div class="mobile-list" id="mobile-list" data-register={registerId}>
    {initialRecords.map((r) => (
      <a href={`/register/${registerId}/${recordSlug(r)}/`} class="m-card">
        <span class="m-card__head"><span class="m-card__num">№ {r.number}</span><span class="m-card__date">{r.date}</span></span>
        <span class="m-card__obj">{truncate(sentenceCase(r.object), 140)}</span>
        <span class="m-card__foot">{r.region && <span class="badge badge--district">{r.region}</span>}</span>
      </a>
    ))}
  </div>

  <div class="table-wrap card">
    <table id="data-table">
      <colgroup>
        <col class="col-number" /><col class="col-date" /><col class="col-object" /><col class="col-region" /><col class="col-meta" /><col class="col-scope" />
      </colgroup>
      <thead>
        <tr>
          <th class="sortable" data-sort="number" aria-sort="none"><button type="button">№ <span class="sort-icon"></span></button></th>
          <th class="sortable" data-sort="date" aria-sort="descending"><button type="button">Дата <span class="sort-icon"></span></button></th>
          <th class="sortable" data-sort="object" aria-sort="none"><button type="button">Строеж / обект <span class="sort-icon"></span></button></th>
          <th class="sortable" data-sort="region" aria-sort="none"><button type="button">Район <span class="sort-icon"></span></button></th>
          <th class="sortable" data-sort="meta" aria-sort="none"><button type="button">{metaLabel} <span class="sort-icon"></span></button></th>
          <th>Местоположение</th>
        </tr>
      </thead>
      <tbody id="table-body">
        {initialRecords.map((r) => (
          <tr>
            <td class="cell-number"><a href={`/register/${registerId}/${recordSlug(r)}/`}>№ {r.number}</a></td>
            <td class="cell-date">{r.date}</td>
            <td class="cell-object">{truncate(sentenceCase(r.object), 180)}</td>
            <td>{r.region}</td>
            <td class="cell-meta">{isPermits ? r.employer : r.constructionOversight}</td>
            <td class="cell-scope">{truncate(r.scope, 100)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <nav class="pagination" id="pagination" aria-label="Страници"></nav>
  <p id="load-error" class="notice" role="status" hidden>Не успяхме да заредим филтрите. <a href={`/register/${registerId}/archive/1/`}>Разгледайте всички документи в архива.</a></p>
  <noscript><p class="notice">За интерактивно търсене включете JavaScript или <a href={`/register/${registerId}/archive/1/`}>разгледайте пълния архив</a>.</p></noscript>

  <section class="section register-about">
    <div class="prose">
      <h2>{isPermits ? "За регистъра на разрешенията за строеж" : "За регистъра на удостоверенията (Акт 16)"}</h2>
      {isPermits ? (
        <p>Регистърът съдържа {fmtNumber(records.length)} разрешения за строеж, издадени от главния архитект на Столична община и на районите от {years[0]} г. насам. За всяко разрешение (в разговорната реч — „разрешително за строеж“) виждате номер, дата, издател, възложител, описание на строежа и местоположение. Как да тълкувате резултата: <a href="/blog/razreshenie-za-stroezh/">проверка на разрешение за строеж</a>.</p>
      ) : (
        <p>Регистърът съдържа {fmtNumber(records.length)} удостоверения за въвеждане в експлоатация на строежи от IV и V категория, издадени в Столична община от {years[0]} г. насам. В обявите за имоти тези документи често се наричат „Акт 16“. Разрешенията за ползване на ДНСК (I–III категория) са в <a href="https://dnsk.bg/registri/publichen-registar-na-razresheniyata-za-polzvane-izdadeni-ot-dnsk/">отделен регистър</a>. Вижте <a href="/blog/proverka-akt-16-online/">как да проверите Акт 16 по адрес</a>.</p>
      )}
      <p>Това е информационна справка по данни от НАГ. Липсата на резултат не доказва липса на документ. <a href={officialUrl}>Проверете официалния регистър.</a></p>
    </div>
    <h3 class="register-about__title">{register.shortLabel} по райони</h3>
    <ul class="region-links">
      {districts.map((d) => <li><a href={`/region/${slugifyRegion(d)}/${registerId}/`}>{isPermits ? "Разрешения за строеж" : "Акт 16"} — {d}</a></li>)}
    </ul>
  </section>

  <script id="register-meta" type="application/json" set:html={JSON.stringify({ metaLabel, registerId, totalRecords: records.length })} />
</Base>

<script>
  import { initRegister } from "../../scripts/register";
  initRegister();
</script>

<style>
  .register-head { display: grid; gap: 1.25rem; align-items: end; }
  @media (min-width: 1000px) { .register-head { grid-template-columns: 1fr auto; } }
  .register-head h1 { font-size: clamp(1.9rem, 1.4rem + 2vw, 3rem); }

  .filters { margin-top: 1.25rem; display: grid; gap: 1rem; }
  .filters__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
  @media (min-width: 900px) { .filters__row { grid-template-columns: 1.2fr 1.4fr 1fr 1fr; } }
  .filters__foot { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; align-items: center; }
  .filters__actions { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .active-filters { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .active-filters:empty { display: none; }

  .results-bar { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; margin: 1.25rem 0 0.75rem; }
  #results-count { font-family: var(--font-display); font-weight: 800; font-size: 1.2rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink); }

  .mobile-list { display: grid; gap: 0.6rem; }
  :global(.m-card) { display: flex; flex-direction: column; gap: 0.4rem; padding: 0.95rem 1rem; background: var(--surface); border: 1px solid var(--line); border-left: 5px solid var(--line-strong); border-radius: var(--radius); color: inherit; }
  :global(.mobile-list[data-register="act16"] .m-card) { border-left-color: var(--mark-act16); }
  :global(.mobile-list[data-register="permits"] .m-card) { border-left-color: var(--mark-permits); }
  :global(.m-card:hover) { color: inherit; box-shadow: var(--shadow); }
  :global(.m-card__head) { display: flex; justify-content: space-between; font-size: 0.85rem; }
  :global(.m-card__num) { font-family: var(--font-mono); font-weight: 700; color: var(--ink); }
  :global(.m-card__date) { color: var(--muted); }
  :global(.m-card__obj) { font-size: 0.93rem; color: var(--ink-2); line-height: 1.45; }
  :global(.m-card__foot) { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; font-size: 0.78rem; color: var(--muted); }

  .table-wrap { display: none; padding: 0; overflow-x: auto; }
  .table-wrap table { table-layout: fixed; min-width: 940px; }
  .col-number { width: 96px; } .col-date { width: 108px; } .col-object { width: 34%; } .col-region { width: 124px; } .col-meta { width: 19%; } .col-scope { width: 21%; }
  :global(th.sortable button) { all: unset; cursor: pointer; display: inline-flex; gap: 0.3rem; align-items: center; }
  :global(th.sortable button:focus-visible) { box-shadow: var(--focus); border-radius: 4px; }
  :global(th.sorted) { color: var(--ink); }
  :global(.cell-number a) { font-family: var(--font-mono); font-weight: 700; white-space: nowrap; }
  :global(.cell-date) { white-space: nowrap; color: var(--muted); font-variant-numeric: tabular-nums; }
  :global(.cell-object) { line-height: 1.45; overflow-wrap: anywhere; }
  :global(.cell-meta), :global(.cell-scope) { font-size: 0.84rem; color: var(--muted); overflow-wrap: anywhere; }
  :global(.row-link) { cursor: pointer; }
  :global(.badge--filter) { border: 0; cursor: pointer; font-family: inherit; }
  :global(.empty-state) { text-align: center; padding: 3rem 1rem !important; color: var(--muted); }
  @media (min-width: 900px) {
    .mobile-list { display: none; }
    .table-wrap { display: block; }
  }

  .pagination { display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-top: 1.25rem; flex-wrap: wrap; }
  :global(.pg-btn), :global(.pg-num) { min-width: 42px; height: 42px; padding: 0 0.75rem; border-radius: var(--radius); border: 1.5px solid var(--line-strong); background: var(--surface); color: var(--ink); font-weight: 700; cursor: pointer; font-family: inherit; }
  :global(.pg-btn:disabled) { opacity: 0.35; cursor: default; }
  :global(.pg-num--active) { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  :global(.pg-numbers) { display: flex; gap: 0.3rem; }
  :global(.pg-ellipsis) { align-self: center; color: var(--muted); }
  :global(.pg-btn__label) { display: none; }
  @media (min-width: 520px) { :global(.pg-btn__label) { display: inline; } }

  .register-about { display: grid; gap: 1rem; }
  .register-about__title { font-size: 1.25rem; margin-top: 0.5rem; }
  .region-links { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 0.35rem 1rem; font-size: 0.93rem; }
  .region-links a { color: var(--ink-2); }
  .region-links a:hover { color: var(--blue); }
</style>
