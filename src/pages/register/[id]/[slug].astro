---
import Base from "../../../layouts/Base.astro";
import Icon from "../../../components/Icon.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import FollowButton from "../../../components/FollowButton.astro";
import DocRow from "../../../components/DocRow.astro";
import { breadcrumbs, canonicalUrl } from "../../../lib/seo";
import { getRegister, findRecordBySlug, extractCadastreIds, extractAddress, recordSlug, slugifyRegion, type RegisterId } from "../../../lib/data";
import { companiesInRecord, hasCompanyPage, getCompanyIndex, splitParties, parseCompany } from "../../../lib/companies";
import { neighborhoodOf, getNeighborhoods, neighborhoodLabel, NEIGHBORHOOD_PAGE_MIN_DOCS } from "../../../lib/places";
import { parcelHistory } from "../../../lib/parcels";
import { classify, buildingTypeLabel } from "../../../lib/classify";
import { longDate, isoDate, sentenceCase, fmtMonths, monthsBetween, dateKey } from "../../../lib/format";

export const prerender = false;

const registerId = Astro.params.id as RegisterId;
const slug = Astro.params.slug!;
if (registerId !== "act16" && registerId !== "permits") {
  return new Response("Not found", { status: 404 });
}
const record = findRecordBySlug(registerId, slug);
if (!record) {
  return new Response("Not found", { status: 404 });
}

const register = getRegister(registerId);
const isPermit = registerId === "permits";
const cadastreIds = extractCadastreIds(record.scope);
const address = extractAddress(record.scope);
const hood = neighborhoodOf(record);
const hoodSummary = hood ? getNeighborhoods().get(hood.slug) : undefined;
const hoodHasPage = !!hoodSummary && hoodSummary.total >= NEIGHBORHOOD_PAGE_MIN_DOCS;
const companies = companiesInRecord(record, registerId);
const partyField = (isPermit ? record.employer : record.constructionOversight) || "";
const otherParties = splitParties(partyField).filter((p) => !parseCompany(p));
const type = classify(record);
const history = parcelHistory(record);
const thisIndex = history.findIndex((d) => d.record === record);

const takeEffectMs = record.takeEffect?.match(/\d{10,}/)?.[0];
const takeEffect = takeEffectMs ? new Date(+takeEffectMs).toLocaleDateString("bg-BG", { day: "numeric", month: "long", year: "numeric", timeZone: "Europe/Sofia" }) : null;

const mapsQuery = address ? `${address}, София, България` : record.region ? `район ${record.region}, София, България` : null;
const mapsUrl = mapsQuery ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapsQuery)}` : null;
const officialUrl = isPermit ? "https://nag.sofia.bg/RegisterBuildingPermitsPortal/Index" : "https://nag.sofia.bg/RegisterCertificateForExploitationBuildings";

const sameHood = hoodSummary
  ? [...hoodSummary.act16.map((r) => ({ registerId: "act16" as RegisterId, record: r })), ...hoodSummary.permits.map((r) => ({ registerId: "permits" as RegisterId, record: r }))]
      .filter((d) => d.record !== record && !history.some((h) => h.record === d.record))
      .sort((a, b) => dateKey(b.record.date) - dateKey(a.record.date))
      .slice(0, 6)
  : [];
const linkedCompany = companies.find((c) => hasCompanyPage(c.slug));
const moreFromCompany = linkedCompany
  ? (getCompanyIndex().get(linkedCompany.slug)?.docs ?? []).filter((d) => d.record !== record).slice(0, 5)
  : [];

const docName = isPermit ? "Разрешение за строеж" : "Удостоверение за въвеждане в експлоатация";
const pageTitle = `${isPermit ? "Разрешение за строеж" : "Акт 16"} № ${record.number} от ${record.date}${record.region ? ` — ${record.region}` : ""}`;
const metaDescription = `${record.documentType} № ${record.number} от ${record.date}${record.region ? " в район " + record.region : ""}, София. ${record.object}`.replace(/\s+/g, " ").slice(0, 165);
const objectText = sentenceCase(record.object);

const permitLd = {
  "@context": "https://schema.org",
  "@type": "GovernmentPermit",
  name: `${record.documentType} № ${record.number} от ${record.date}`,
  identifier: `${record.number}/${record.date}`,
  description: record.object.replace(/\s+/g, " ").slice(0, 500),
  url: canonicalUrl(Astro.url.pathname),
  validFrom: isoDate(record.date),
  issuedBy: { "@type": "GovernmentOrganization", name: `${record.issuer || "Столична община"}, Столична община` },
  validIn: { "@type": "AdministrativeArea", name: record.region ? `Район ${record.region}, София` : "София" },
};

Astro.response.headers.set("Cache-Control", "public, max-age=3600");
---

<Base title={pageTitle} description={metaDescription} structuredData={[permitLd, breadcrumbs([
  { name: "Начало", path: "/" },
  { name: register.label, path: `/register/${registerId}/` },
  ...(record.region ? [{ name: record.region, path: `/region/${slugifyRegion(record.region)}/` }] : []),
  { name: `№ ${record.number} от ${record.date}`, path: Astro.url.pathname },
])]}>
  <Breadcrumbs items={[
    { name: "Начало", path: "/" },
    { name: register.shortLabel, path: `/register/${registerId}/` },
    ...(record.region ? [{ name: record.region, path: `/region/${slugifyRegion(record.region)}/${registerId}/` }] : []),
    { name: `№ ${record.number}` },
  ]} />

  <div class="layout-aside doc-layout">
    <article class:list={["sheet", `sheet--${registerId}`]}>
      <header class="sheet__head">
        <div class="sheet__kicker">
          <span class:list={["badge", `badge--${registerId}`]}>{isPermit ? "Разрешение за строеж" : "Акт 16"}</span>
          <span class="sheet__type">{record.documentType}</span>
        </div>
        <h1>{docName} № {record.number}</h1>
        <div class="sheet__meta">
          <span><Icon name="calendar" size={16} /> <time datetime={isoDate(record.date)}>{longDate(record.date)}</time></span>
          {record.region && <a class="badge badge--district" href={`/region/${slugifyRegion(record.region)}/`}>{record.region}</a>}
          {hood && (hoodHasPage ? <a class="badge" href={`/neighborhood/${hood.slug}/`}>{neighborhoodLabel(hood)}</a> : <span class="badge">{neighborhoodLabel(hood)}</span>)}
          {record.status && <span class:list={["badge", record.status.startsWith("Отменен") ? "badge--warn" : "badge--status"]}>{record.status}</span>}
        </div>
        <div class:list={["stamp", "sheet__stamp", `stamp--${registerId}`]} aria-hidden="true">
          {isPermit ? "Разрешен строеж" : "Въведен в експлоатация"}
          <small>{record.date}</small>
        </div>
      </header>

      <section class="sheet__section">
        <h2 class="sheet__label">Описание на строежа</h2>
        <p class="sheet__object">{objectText}</p>
      </section>

      <dl class="sheet__grid">
        {partyField && (
          <div class="sheet__field sheet__field--wide">
            <dt>{isPermit ? "Възложител" : "Строителен надзор"}</dt>
            <dd>
              {companies.map((c) => hasCompanyPage(c.slug) ? <a href={`/company/${c.slug}/`}>{c.display}</a> : <span>{c.display}</span>)}
              {otherParties.length > 0 && <span>{otherParties.join(", ")}</span>}
            </dd>
          </div>
        )}
        {record.issuer && <div class="sheet__field"><dt>Издател</dt><dd>{record.issuer}</dd></div>}
        {takeEffect && <div class="sheet__field"><dt>Влиза в сила</dt><dd>{takeEffect}</dd></div>}
        <div class="sheet__field"><dt>Тип сграда</dt><dd>{buildingTypeLabel(type)}</dd></div>
        {cadastreIds.length > 0 && (
          <div class="sheet__field">
            <dt>Идентификатор КККР</dt>
            <dd class="mono">{cadastreIds.map((id) => <button type="button" class="copy-id" data-copy={id} title="Копирай">{id} <Icon name="copy" size={13} /></button>)}</dd>
          </div>
        )}
      </dl>

      <section class="sheet__section">
        <h2 class="sheet__label">Местоположение</h2>
        <p class="sheet__scope">{record.scope}</p>
        <div class="sheet__actions">
          <a class="btn btn--ghost btn--sm" href={`/map/#${registerId}:${recordSlug(record)}`}><Icon name="map" size={16} /> На картата</a>
          {mapsUrl && <a class="btn btn--ghost btn--sm" href={mapsUrl} target="_blank" rel="noopener"><Icon name="pin" size={16} /> Google Maps</a>}
          <a class="btn btn--ghost btn--sm" href={officialUrl} target="_blank" rel="noopener"><Icon name="external" size={16} /> Официален регистър</a>
        </div>
      </section>

      <p class="sheet__note">Информационна справка по данни от публичния регистър на НАГ. Потвърдете документа и неговия обхват в официалния регистър или при издателя.</p>
    </article>

    <aside class="doc-aside">
      <div class="card aside-card">
        <h2 class="aside-card__title">Действия</h2>
        <div class="aside-actions">
          <FollowButton kind={cadastreIds.length ? "parcel" : "record"} itemKey={cadastreIds[0] ?? `${registerId}:${slug}`} label={`${cadastreIds[0] ? "Имот " + cadastreIds[0] : docName + " № " + record.number}${record.region ? " · " + record.region : ""}`} url={Astro.url.pathname} />
          <button type="button" class="btn btn--ghost btn--sm" data-copy="url" data-share="1"><Icon name="share" size={16} /> Сподели</button>
          <a class="btn btn--ghost btn--sm" href={`/check/?q=${encodeURIComponent(cadastreIds[0] ?? record.number)}`}><Icon name="search" size={16} /> История</a>
        </div>
      </div>

      <section class="card aside-card" aria-labelledby="history-title">
        <h2 class="aside-card__title" id="history-title">История на имота</h2>
        {history.length > 1 ? (
          <ol class="timeline">
            {history.map((doc, i) => {
              const gap = i > 0 ? monthsBetween(history[i - 1].record.date, doc.record.date) : 0;
              const current = i === thisIndex;
              return (
                <li class:list={["timeline__item", `timeline__item--${doc.registerId}`, { "is-current": current }]}>
                  {i > 0 && gap >= 1 && <span class="timeline__gap">+ {fmtMonths(gap)}</span>}
                  <a href={`/register/${doc.registerId}/${recordSlug(doc.record)}/`} aria-current={current ? "page" : undefined}>
                    <strong>{doc.registerId === "act16" ? "Акт 16" : "Разрешение за строеж"} № {doc.record.number}</strong>
                    <span>{longDate(doc.record.date)}</span>
                    <small>{sentenceCase(doc.record.object).slice(0, 90)}{doc.record.object.length > 90 ? "…" : ""}</small>
                  </a>
                </li>
              );
            })}
          </ol>
        ) : (
          <p class="muted aside-card__text">{cadastreIds.length ? "Няма други документи за същия кадастрален идентификатор в двата регистъра." : "Документът няма посочен кадастрален идентификатор, затова не можем да свържем историята на имота."}</p>
        )}
        {!isPermit && !history.some((d) => d.registerId === "permits") && cadastreIds.length > 0 && (
          <p class="aside-card__text muted">Разрешението за строеж може да е издадено преди 2021 г. или с друг идентификатор.</p>
        )}
      </section>

      {hood && (
        <section class="card aside-card">
          <h2 class="aside-card__title">Квартал</h2>
          <p class="aside-card__text">{neighborhoodLabel(hood)}{record.region && <>, район {record.region}</>}</p>
          <div class="aside-actions">
            {hoodHasPage && <a class="btn btn--ghost btn--sm" href={`/neighborhood/${hood.slug}/`}>Строителство в {hood.name}</a>}
            {record.region && <a class="btn btn--ghost btn--sm" href={`/region/${slugifyRegion(record.region)}/`}>Район {record.region}</a>}
          </div>
        </section>
      )}
    </aside>
  </div>

  {sameHood.length > 0 && hood && (
    <section class="section">
      <div class="section-head">
        <h2>Още документи в {neighborhoodLabel(hood)}</h2>
        {hoodHasPage && <a class="section-head__link" href={`/neighborhood/${hood.slug}/`}>Всички <Icon name="arrow" size={16} /></a>}
      </div>
      <ul class="doc-list">{sameHood.map((d) => <DocRow registerId={d.registerId} record={d.record} showParty />)}</ul>
    </section>
  )}

  {moreFromCompany.length > 0 && linkedCompany && (
    <section class="section">
      <div class="section-head">
        <h2>Още документи на {linkedCompany.display}</h2>
        <a class="section-head__link" href={`/company/${linkedCompany.slug}/`}>Профил на фирмата <Icon name="arrow" size={16} /></a>
      </div>
      <ul class="doc-list">{moreFromCompany.map((d) => <DocRow registerId={d.registerId} record={d.record} />)}</ul>
    </section>
  )}
</Base>

<style>
  .doc-layout { margin-top: 0.5rem; }
  .sheet {
    position: relative; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg);
    padding: clamp(1.2rem, 0.8rem + 2vw, 2.4rem); box-shadow: var(--shadow);
    background-image: linear-gradient(var(--surface), var(--surface)), linear-gradient(90deg, transparent 0, transparent 100%);
  }
  .sheet::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 8px; border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
  .sheet--act16::before { background: var(--mark-act16); }
  .sheet--permits::before { background: var(--mark-permits); }
  .sheet__head { position: relative; padding-bottom: 1.25rem; border-bottom: 2px solid var(--ink); margin-bottom: 1.5rem; }
  .sheet__kicker { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
  .sheet__type { font-size: 0.8rem; color: var(--muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
  .sheet h1 { font-size: clamp(1.7rem, 1.3rem + 1.8vw, 2.6rem); margin-top: 0.7rem; max-width: 80%; }
  .sheet__meta { display: flex; flex-wrap: wrap; gap: 0.5rem 0.75rem; align-items: center; margin-top: 0.9rem; color: var(--ink-2); font-weight: 600; font-size: 0.95rem; }
  .sheet__meta > span:first-child { display: inline-flex; align-items: center; gap: 0.35rem; }
  .sheet__stamp { position: absolute; right: 0; top: 2.6rem; }
  @media (max-width: 640px) { .sheet__stamp { position: static; margin-top: 1rem; } .sheet h1 { max-width: none; } }
  .sheet__section { margin-bottom: 1.6rem; }
  .sheet__label { font-family: var(--font-display); font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); margin-bottom: 0.5rem; }
  .sheet__object { font-size: 1.15rem; line-height: 1.6; color: var(--ink); }
  .sheet__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; margin-bottom: 1.6rem; }
  .sheet__field { background: var(--surface-2); padding: 0.85rem 1rem; }
  .sheet__field--wide { grid-column: 1 / -1; }
  .sheet__field dt { font-family: var(--font-display); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-weight: 700; }
  .sheet__field dd { margin-top: 0.25rem; font-weight: 600; color: var(--ink); display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; }
  .copy-id { all: unset; cursor: pointer; display: inline-flex; align-items: center; gap: 0.3rem; color: var(--blue); font-family: var(--font-mono); }
  .copy-id:hover { color: var(--ink); }
  .copy-id:focus-visible { box-shadow: var(--focus); border-radius: 4px; }
  .sheet__scope { background: var(--surface-2); border: 1px dashed var(--line-strong); border-radius: var(--radius); padding: 0.85rem 1rem; font-size: 0.95rem; overflow-wrap: anywhere; }
  .sheet__actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.85rem; }
  .sheet__note { font-size: 0.85rem; color: var(--muted); border-top: 1px dashed var(--line-strong); padding-top: 1rem; }

  .doc-aside { display: grid; gap: 1rem; }
  .aside-card { padding: 1.15rem; }
  .aside-card__title { font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.8rem; }
  .aside-card__text { font-size: 0.93rem; margin-bottom: 0.75rem; }
  .aside-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .timeline { list-style: none; display: grid; gap: 0; }
  .timeline__item { position: relative; padding-left: 1.4rem; }
  .timeline__item::before { content: ""; position: absolute; left: 4px; top: 0; bottom: 0; width: 2px; background: var(--line-strong); }
  .timeline__item:first-child::before { top: 0.9rem; }
  .timeline__item:last-child::before { bottom: auto; height: 0.9rem; }
  .timeline__item a { position: relative; display: flex; flex-direction: column; padding: 0.5rem 0.6rem; border-radius: var(--radius-sm); color: var(--ink-2); font-size: 0.88rem; }
  .timeline__item a::before { content: ""; position: absolute; left: -1.35rem; top: 0.75rem; width: 12px; height: 12px; border-radius: 50%; border: 2px solid var(--surface); }
  .timeline__item--act16 a::before { background: var(--mark-act16); }
  .timeline__item--permits a::before { background: var(--mark-permits); }
  .timeline__item a:hover { background: var(--surface-2); color: var(--ink); }
  .timeline__item.is-current a { background: var(--yellow-soft); }
  .timeline__item strong { color: var(--ink); }
  .timeline__item small { color: var(--muted); }
  .timeline__gap { display: inline-block; margin: 0.15rem 0 0.15rem 0.5rem; font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); background: var(--bg-deep); padding: 0 0.4rem; border-radius: 4px; }
</style>
