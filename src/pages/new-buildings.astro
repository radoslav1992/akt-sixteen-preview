---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import RecordCard from "../components/RecordCard.astro";
import BarList from "../components/BarList.astro";
import Icon from "../components/Icon.astro";
import { breadcrumbs } from "../lib/seo";
import { getRecords, recordSlug, slugifyRegion } from "../lib/data";
import { classify, isNewApartmentBuilding } from "../lib/classify";
import { pipelineMatches, durationStats } from "../lib/parcels";
import { countBy, inLastDays, sortByDateDesc, latestRecordDate } from "../lib/stats";
import { fmtNumber, fmtMonths } from "../lib/format";

const newAct16 = sortByDateDesc(getRecords("act16").filter(isNewApartmentBuilding));
const recent = inLastDays(newAct16, 730);
const permits = sortByDateDesc(getRecords("permits").filter(isNewApartmentBuilding));
const pipeline = inLastDays(permits, 365).slice(0, 12);
const year = latestRecordDate().slice(-4);
const thisYear = newAct16.filter((r) => r.date.endsWith(year));
const byRegion = [...countBy(inLastDays(newAct16, 365), (r) => r.region).entries()].sort((a, b) => b[1] - a[1]);
const dur = durationStats(pipelineMatches().filter((m) => isNewApartmentBuilding(m.certificate)));
const regionsWithNew = [...new Set(recent.map((r) => r.region).filter(Boolean))].sort((a, b) => a.localeCompare(b, "bg"));

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Нови жилищни сгради с Акт 16 в София",
  numberOfItems: Math.min(30, recent.length),
  itemListElement: recent.slice(0, 30).map((r, i) => ({ "@type": "ListItem", position: i + 1, url: `https://akt16.org/register/act16/${recordSlug(r)}/` })),
};
---

<Base
  title={`Нови жилищни сгради с Акт 16 в София (${year}) — ново строителство`}
  description={`Апартаменти в ново строителство с Акт 16 в София: ${fmtNumber(thisYear.length)} нови многофамилни сгради с удостоверение за въвеждане в експлоатация през ${year} г., по райони, с инвеститор и надзор.`}
  structuredData={[itemList, breadcrumbs([{ name: "Начало", path: "/" }, { name: "Нови сгради с Акт 16", path: "/new-buildings/" }])]}
>
  <Breadcrumbs items={[{ name: "Начало", path: "/" }, { name: "Нови сгради с Акт 16" }]} />
  <header class="page-head">
    <span class="eyebrow">За купувачи на ново строителство</span>
    <h1>Нови жилищни сгради с Акт 16 в София</h1>
    <p class="page-head__lead">Многофамилни жилищни сгради, които наскоро са получили удостоверение за въвеждане в експлоатация от Столична община. Подходящо, ако търсите апартамент с Акт 16 или искате да проверите обявен „завършен“ проект.</p>
    <div class="page-head__actions">
      <a class="btn btn--primary" href="/check/"><Icon name="search" /> Провери конкретна сграда</a>
      <a class="btn btn--ghost" href="/blog/apartamenti-s-akt-16-sofia/">Как да проверите новото строителство</a>
    </div>
  </header>

  <section class="stat-grid">
    <div class="stat stat--act16"><div class="stat__value">{fmtNumber(thisYear.length)}</div><div class="stat__label">Нови блокове с Акт 16 през {year}</div></div>
    <div class="stat stat--act16"><div class="stat__value">{fmtNumber(inLastDays(newAct16, 365).length)}</div><div class="stat__label">за последните 12 месеца</div></div>
    <div class="stat stat--permits"><div class="stat__value">{fmtNumber(inLastDays(permits, 365).length)}</div><div class="stat__label">нови разрешения за блокове</div><div class="stat__sub">за последните 12 месеца</div></div>
    <div class="stat"><div class="stat__value">{fmtMonths(dur.median)}</div><div class="stat__label">типичен срок до Акт 16</div><div class="stat__sub">медиана, {dur.count} сгради</div></div>
  </section>

  <section class="section">
    <div class="section-head">
      <div><h2>Въведени в експлоатация за последните 2 години</h2><p>{fmtNumber(recent.length)} сгради, най-новите първи.</p></div>
    </div>
    <div class="chip-row region-filter" role="group" aria-label="Филтър по район">
      <button type="button" class="chip chip--active" data-region="">Всички</button>
      {regionsWithNew.map((r) => <button type="button" class="chip" data-region={r}>{r}</button>)}
    </div>
    <div class="grid-auto" id="new-list">
      {recent.map((r) => <div data-region={r.region}><RecordCard registerId="act16" record={r} /></div>)}
    </div>
  </section>

  <section class="section grid-2">
    <div class="card">
      <h2 class="card-title">Къде се завършват нови блокове</h2>
      <p class="muted card-sub">Нови многофамилни сгради с Акт 16 за последните 12 месеца</p>
      <BarList tone="act16" rows={byRegion.slice(0, 12).map(([name, n]) => ({ label: name, value: n, href: `/region/${slugifyRegion(name)}/act16/` }))} />
    </div>
    <div class="card">
      <h2 class="card-title">Предстоящи: нови разрешения за жилищни сгради</h2>
      <p class="muted card-sub">Тези проекти обикновено получават Акт 16 след около {fmtMonths(dur.median)}.</p>
      <ul class="doc-list">
        {pipeline.map((r) => (
          <li><a class="doc-row" href={`/register/permits/${recordSlug(r)}/`}><span class="doc-row__kind doc-row__kind--permits"></span><span class="doc-row__top"><span class="doc-row__num">№ {r.number}</span> {r.date} · {r.region}</span><span class="doc-row__text">{r.employer || r.object.slice(0, 90)}</span></a></li>
        ))}
      </ul>
      <a class="section-head__link more-link" href="/register/permits/#type=multi">Всички разрешения за жилищни сгради <Icon name="arrow" size={16} /></a>
    </div>
  </section>

  <section class="section prose new-notes">
    <h2>Какво да проверите преди покупка</h2>
    <ul>
      <li>Дали удостоверението е за <b>цялата сграда</b> или за отделен етап — прочетете описанието на строежа.</li>
      <li>Дали адресът и кадастралният идентификатор съвпадат с имота от обявата.</li>
      <li>Кой е <b>възложителят</b> — отворете профила на фирмата и вижте другите ѝ проекти.</li>
      <li>Потвърдете документа в официалния регистър на НАГ. Сградите от I–III категория получават разрешение за ползване от ДНСК и може да не са в този списък.</li>
    </ul>
  </section>
</Base>

<script>
  const items = [...document.querySelectorAll<HTMLElement>("#new-list > [data-region]")];
  document.querySelectorAll<HTMLButtonElement>(".region-filter [data-region]").forEach((btn) =>
    btn.addEventListener("click", () => {
      document.querySelectorAll(".region-filter .chip").forEach((c) => c.classList.remove("chip--active"));
      btn.classList.add("chip--active");
      for (const el of items) el.hidden = !!btn.dataset.region && el.dataset.region !== btn.dataset.region;
    })
  );
</script>

<style>
  .region-filter { margin-bottom: 1rem; }
  #new-list > div { display: flex; }
  #new-list > div > :global(*) { flex: 1; }
  #new-list > div[hidden] { display: none; }
  .card-title { font-size: 1.3rem; }
  .card-sub { font-size: 0.88rem; margin: 0.3rem 0 1rem; }
  .more-link { margin-top: 1rem; display: inline-flex; }
  .new-notes { max-width: 820px; }
</style>
