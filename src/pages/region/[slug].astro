---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import FollowButton from "../../components/FollowButton.astro";
import RecordCard from "../../components/RecordCard.astro";
import YearBars from "../../components/YearBars.astro";
import SofiaMap from "../../components/SofiaMap.astro";
import BarList from "../../components/BarList.astro";
import { breadcrumbs } from "../../lib/seo";
import { findRegionBySlug, getRegionRecords, getAllRegionsWithSlugs } from "../../lib/data";
import { getListedNeighborhoods, neighborhoodLabel } from "../../lib/places";
import { companiesInRecord, hasCompanyPage, getCompanyIndex } from "../../lib/companies";
import { classify, BUILDING_TYPES } from "../../lib/classify";
import { pipelineMatches, durationStats } from "../../lib/parcels";
import { byYear, countBy, inLastDays } from "../../lib/stats";
import { fmtNumber, fmtMonths } from "../../lib/format";

export function getStaticPaths() {
  return getAllRegionsWithSlugs().map((r) => ({ params: { slug: r.slug }, props: { regionName: r.name } }));
}

const { regionName } = Astro.props as { regionName: string };
if (!findRegionBySlug(Astro.params.slug!)) {
  return new Response("Not found", { status: 404 });
}
const slug = Astro.params.slug!;
const { act16, permits } = getRegionRecords(regionName);
const total = act16.length + permits.length;
const allRegions = getAllRegionsWithSlugs();
const rank = allRegions.findIndex((r) => r.name === regionName) + 1;

const lastYear = { act16: inLastDays(act16, 365).length, permits: inLastDays(permits, 365).length };
const dur = durationStats(pipelineMatches().filter((m) => m.certificate.region === regionName));
const neighborhoods = getListedNeighborhoods().filter((n) => n.regions[0]?.[0] === regionName);
const types = countBy([...act16, ...permits], classify);
const residentialShare = Math.round((((types.get("multi") ?? 0) + (types.get("single") ?? 0)) / Math.max(1, total)) * 100);

function topParties(registerId: "permits" | "act16", records: typeof act16) {
  const counts = new Map<string, number>();
  for (const r of records) for (const c of companiesInRecord(r, registerId)) if (!c.form.length ? false : hasCompanyPage(c.slug)) counts.set(c.slug, (counts.get(c.slug) ?? 0) + 1);
  return [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 6).map(([s, n]) => ({ company: getCompanyIndex().get(s)!, n }));
}
const topEmployers = topParties("permits", permits);
const topOversight = topParties("act16", act16);

const description = `Регистър на разрешенията за строеж (${permits.length}) и удостоверенията за въвеждане в експлоатация Акт 16 (${act16.length}) в район ${regionName}, София. Данните се обновяват автоматично от НАГ.`;
const counts = new Map(allRegions.map((r) => [r.name, r.act16 + r.permits]));

const placeLd = {
  "@context": "https://schema.org",
  "@type": "AdministrativeArea",
  name: `Район ${regionName}`,
  containedInPlace: { "@type": "City", name: "София" },
  url: `https://akt16.org/region/${slug}/`,
};
---

<Base
  title={`Акт 16 в ${regionName}, София — проверка и разрешения`}
  description={description}
  structuredData={[placeLd, breadcrumbs([{ name: "Начало", path: "/" }, { name: "Райони", path: "/region/" }, { name: regionName, path: Astro.url.pathname }])]}
  feeds={[{ title: `Район ${regionName} — нови документи`, href: `/region/${slug}/rss.xml` }]}
>
  <Breadcrumbs items={[{ name: "Начало", path: "/" }, { name: "Райони", path: "/region/" }, { name: `Район ${regionName}` }]} />

  <header class="page-head region-head">
    <div>
      <span class="eyebrow">Район в София · №{rank} по активност</span>
      <h1>Акт 16 и разрешения за строеж — {regionName}</h1>
      <p class="page-head__lead">
        {fmtNumber(total)} строителни документа в публичните регистри на НАГ — {fmtNumber(act16.length)} удостоверения Акт 16 и {fmtNumber(permits.length)} разрешения за строеж.
      </p>
      <div class="page-head__actions">
        <a class="btn btn--primary" href={`/region/${slug}/act16/`}>Всички Акт 16 в {regionName}</a>
        <a class="btn btn--ghost" href={`/region/${slug}/permits/`}>Разрешения за строеж</a>
        <FollowButton kind="region" itemKey={slug} label={`Район ${regionName}`} url={`/region/${slug}/`} />
      </div>
    </div>
  </header>

  <section class="stat-grid region-stats" aria-label="Обобщение за района">
    <a class="stat stat--act16" href={`/region/${slug}/act16/`}><div class="stat__value">{fmtNumber(act16.length)}</div><div class="stat__label">Акт 16</div><div class="stat__sub">{lastYear.act16} за последните 12 месеца</div></a>
    <a class="stat stat--permits" href={`/region/${slug}/permits/`}><div class="stat__value">{fmtNumber(permits.length)}</div><div class="stat__label">Разрешения за строеж</div><div class="stat__sub">{lastYear.permits} за последните 12 месеца</div></a>
    <div class="stat"><div class="stat__value">{dur.count >= 10 ? fmtMonths(dur.median) : "—"}</div><div class="stat__label">От разрешение до Акт 16</div><div class="stat__sub">{dur.count >= 10 ? `медиана за ${dur.count} имота` : "недостатъчно данни"}</div></div>
    <div class="stat"><div class="stat__value">{residentialShare}%</div><div class="stat__label">Жилищни сгради</div><div class="stat__sub">дял от всички документи</div></div>
  </section>

  <section class="section grid-2">
    <div class="card">
      <h2 class="card-title">Издадени документи по години</h2>
      <YearBars caption={`Документи по години в район ${regionName}`} series={[
        { id: "permits", label: "Разрешения за строеж", values: byYear(permits) },
        { id: "act16", label: "Акт 16", values: byYear(act16) },
      ]} />
    </div>
    <div class="card">
      <h2 class="card-title">{regionName} на картата</h2>
      <SofiaMap counts={counts} highlight={regionName} caption={`Район ${regionName} спрямо другите райони на София`} />
      <a class="section-head__link" href="/map/">Отвори интерактивната карта <Icon name="arrow" size={16} /></a>
    </div>
  </section>

  {neighborhoods.length > 0 && (
    <section class="section">
      <div class="section-head"><h2>Квартали и местности в {regionName}</h2></div>
      <div class="chip-row">
        {neighborhoods.map((n) => <a class="chip" href={`/neighborhood/${n.slug}/`}>{neighborhoodLabel(n)} <span class="chip__count">{n.total}</span></a>)}
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-head">
      <h2>Последни Акт 16 в {regionName}</h2>
      <a class="section-head__link" href={`/region/${slug}/act16/`}>Всички {fmtNumber(act16.length)} <Icon name="arrow" size={16} /></a>
    </div>
    <div class="grid-auto">{act16.slice(0, 6).map((r) => <RecordCard registerId="act16" record={r} />)}</div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Последни разрешения за строеж в {regionName}</h2>
      <a class="section-head__link" href={`/region/${slug}/permits/`}>Всички {fmtNumber(permits.length)} <Icon name="arrow" size={16} /></a>
    </div>
    <div class="grid-auto">{permits.slice(0, 6).map((r) => <RecordCard registerId="permits" record={r} />)}</div>
  </section>

  <section class="section grid-2">
    {topEmployers.length > 0 && (
      <div class="card">
        <h2 class="card-title">Най-активни възложители</h2>
        <BarList tone="permits" rows={topEmployers.map(({ company, n }) => ({ label: company.display, value: n, href: `/company/${company.slug}/` }))} />
      </div>
    )}
    {topOversight.length > 0 && (
      <div class="card">
        <h2 class="card-title">Строителен надзор</h2>
        <BarList tone="act16" rows={topOversight.map(({ company, n }) => ({ label: company.display, value: n, href: `/company/${company.slug}/` }))} />
      </div>
    )}
    <div class="card">
      <h2 class="card-title">Какво се строи</h2>
      <BarList rows={BUILDING_TYPES.map((t) => ({ label: t.label, value: types.get(t.id) ?? 0 })).filter((r) => r.value > 0).sort((a, b) => b.value - a.value)} />
    </div>
    <div class="card prose region-howto">
      <h2>Как да проверя Акт 16 в {regionName}?</h2>
      <p>За проверка на конкретно жилище в район {regionName} използвайте <a href="/check/">проверката на имот</a> или отворете съответния регистър и въведете адрес или кадастрален идентификатор. Сравнете местоположението и обхвата на намерения документ.</p>
      <p><a href="/blog/proverka-akt-16-online/">Как да проверя Акт 16 по адрес?</a></p>
    </div>
  </section>

  <section class="section">
    <h2 class="other-title">Други райони</h2>
    <div class="chip-row">
      {allRegions.filter((r) => r.name !== regionName).map((r) => <a class="chip" href={`/region/${r.slug}/`}>{r.name}</a>)}
    </div>
  </section>
</Base>

<style>
  .region-head h1 { font-size: clamp(2rem, 1.4rem + 2.6vw, 3.4rem); }
  .region-stats { margin-top: 1.25rem; }
  a.stat { color: inherit; transition: border-color var(--transition); }
  a.stat:hover { border-color: var(--ink); color: inherit; }
  .card-title { font-size: 1.35rem; margin-bottom: 1rem; }
  .other-title { font-size: 1.3rem; margin-bottom: 0.8rem; }
  .region-howto h2 { margin-top: 0; font-size: 1.35rem; }
</style>
