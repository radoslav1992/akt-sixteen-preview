{
	"compatibility_date": "2026-04-17",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "real-estate-certificates",
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Page paths go to the worker first, so "/check" gets a permanent 301 to "/check/" (src/lib/seo.ts)
		// instead of the asset handler's temporary 307; the worker then serves the static page from ASSETS.
		// Files are served directly. Negative rules always win and never fall back to the worker, so they
		// list file types only (a "!/*/" rule would 404 the on-demand register and document pages).
		"run_worker_first": ["/*", "!/_astro/*", "!/*.css", "!/*.js", "!/*.json", "!/*.xml", "!/*.txt", "!/*.csv", "!/*.zip", "!/*.png", "!/*.svg", "!/*.ico", "!/*.woff2", "!/*.html"]
	},
	"observability": {
		"enabled": true
	},
	// Cloudflare Email Service: onboard akt16.org under Email Service → Email Sending first.
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	"vars": {
		"EMAIL_FROM": "noreply@akt16.org"
	},
	// Daily alert digests, after the 08:00 UTC scrape has been deployed.
	"triggers": {
		"crons": ["20 10 * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "akt16",
			"database_id": "4efa8be0-c21c-4a01-a213-b2e7034059bc",
			"migrations_dir": "migrations"
		}
	]
}